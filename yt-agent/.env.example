# Anthropic (Claude) — required
ANTHROPIC_API_KEY=your_key_here

# OpenAI (DALL-E image generation) — required for image gen
OPENAI_API_KEY=your_key_here

# YouTube API OAuth2 — required for upload
# Get from Google Cloud Console: https://console.cloud.google.com
# Download client_secrets.json and run: python run.py auth
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret

# ElevenLabs (optional, premium TTS — better voice quality)
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id

# Stability AI (optional, alternative to DALL-E)
STABILITY_API_KEY=your_key_here
